NEXT_PUBLIC_SITE_URL=https://ilazim.online
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Opsiyonel — Whop ödeme (veya Admin → Ayarlar'dan girin)
WHOP_API_KEY=
WHOP_COMPANY_ID=biz_
WHOP_WEBHOOK_SECRET=ws_
WHOP_PRODUCT_ID=

# Opsiyonel — eşleşen ilan e-postası (Resend). Yoksa yalnızca uygulama içi bildirim gider.
RESEND_API_KEY=
EMAIL_FROM=Talepik <noreply@senin-domainin.com>

# Opsiyonel — kayıt/şifre maillerini de aynı şablondan Resend ile göndermek için
# Supabase Auth → Hooks → Send Email. Endpoint: https://ilazim.online/api/auth/send-email
AUTH_HOOK_SECRET=
